
#include <stdio.h>
int main() {
    int p[20],f[10],t[10],n,m,i,j,pos,hit,fault=0;

    printf("Enter number of pages: ");
    scanf("%d",&n);
    printf("Enter pages: ");
    for(i=0;i<n;i++) scanf("%d",&p[i]);
    printf("Enter frames: ");
    scanf("%d",&m);

    for(i=0;i<m;i++) {
        f[i]=-1;
        t[i]=0;
    }

    for(i=0;i<n;i++) {
        hit=0;
        pos=-1;

        for(j=0;j<m;j++)
            if(f[j]==p[i]) {
                hit=1;
                pos=j;
            }

        if(!hit) {
            pos=-1;
            for(j=0;j<m;j++)
                if(f[j]==-1) {
                    pos=j;
                    break;
                }

            if(pos==-1) {
                pos=0;
                for(j=1;j<m;j++)
                    if(t[j]<t[pos]) pos=j;
            }
            f[pos]=p[i];
            fault++;
        }

        t[pos]=i+1;

        for(j=0;j<m;j++) printf("%d ",f[j]);
        printf("\n");
    }

    printf("Page Faults: %d",fault);
    return 0;
}
