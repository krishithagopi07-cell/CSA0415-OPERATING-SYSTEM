#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <sys/mman.h>
#include <sys/wait.h>

int main() {
    char *shm = mmap(NULL, 100,
        PROT_READ | PROT_WRITE,
        MAP_SHARED | MAP_ANONYMOUS, -1, 0);

    if (shm == MAP_FAILED) {
        perror("mmap");
        return 1;
    }

    pid_t pid = fork();

    if (pid == 0) {
        sleep(1);
        printf("Reader received: %s\n", shm);
    } else if (pid > 0) {
        strcpy(shm, "Hello from Writer");
        printf("Writer sent: %s\n", shm);
        wait(NULL);
    } else {
        perror("fork");
        munmap(shm, 100);
        return 1;
    }

    munmap(shm, 100);
    return 0;
}
