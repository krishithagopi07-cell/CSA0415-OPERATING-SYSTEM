
#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int at[10], bt[10], rt[10], pr[10];
    int ct[10] = {0}, tat[10], wt[10];
    int highest;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter arrival time, burst time and priority for P%d: ", i + 1);
        scanf("%d %d %d", &at[i], &bt[i], &pr[i]);
        rt[i] = bt[i];
    }

    while (completed < n) {
        highest = -1;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0) {
                if (highest == -1 || pr[i] < pr[highest])
                    highest = i;
            }
        }

        if (highest == -1) {
            time++;
            continue;
        }

        rt[highest]--;
        time++;

        if (rt[highest] == 0) {
            ct[highest] = time;
            completed++;
        }
    }

    printf("\nProcess\tCT\tTAT\tWT\n");

    for (i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];

        printf("P%d\t%d\t%d\t%d\n",
               i + 1, ct[i], tat[i], wt[i]);
    }

    return 0;
}
