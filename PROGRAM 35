
#include <stdio.h>
int main() {
    int index,n,b[20],i;

    printf("Enter index block: ");
    scanf("%d",&index);
    printf("Enter number of blocks: ");
    scanf("%d",&n);

    printf("Enter block numbers: ");
    for(i=0;i<n;i++) scanf("%d",&b[i]);

    printf("Index Block: %d\n",index);
    printf("File Block\tIndex Entry\n");

    for(i=0;i<n;i++)
        printf("%d\t\t%d\n",i+1,b[i]);

    return 0;
}
