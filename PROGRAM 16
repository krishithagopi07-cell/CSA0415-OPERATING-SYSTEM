
#include <stdio.h>

struct Employee {
    int id;
    char name[30];
    float salary;
};

int main() {
    FILE *fp;
    struct Employee e;
    int n, i, searchId, found = 0;

    fp = fopen("employee.dat", "wb+");

    if (fp == NULL) {
        printf("File cannot be opened");
        return 1;
    }

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter Employee ID, Name and Salary: ");
        scanf("%d %29s %f", &e.id, e.name, &e.salary);
        fwrite(&e, sizeof(e), 1, fp);
    }

    printf("\nEnter Employee ID to search: ");
    scanf("%d", &searchId);

    for (i = 0; i < n; i++) {
        fseek(fp, i * sizeof(e), SEEK_SET);
        fread(&e, sizeof(e), 1, fp);

        if (e.id == searchId) {
            printf("\nEmployee Found!");
            printf("\nID: %d", e.id);
            printf("\nName: %s", e.name);
            printf("\nSalary: %.2f\n", e.salary);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("\nEmployee not found.\n");

    fclose(fp);
    return 0;
}
