#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct message {
    long type;
    char text[100];
};

int main() {
    int id;
    struct message msg;

    id = msgget(IPC_PRIVATE, 0666 | IPC_CREAT);

    if (id == -1) {
        perror("msgget");
        return 1;
    }

    msg.type = 1;
    strcpy(msg.text, "Hello from Sender");

    if (msgsnd(id, &msg, sizeof(msg.text), 0) == -1) {
        perror("msgsnd");
        msgctl(id, IPC_RMID, NULL);
        return 1;
    }

    printf("Sender: Message sent\n");

    if (msgrcv(id, &msg, sizeof(msg.text), 1, 0) == -1) {
        perror("msgrcv");
        msgctl(id, IPC_RMID, NULL);
        return 1;
    }

    printf("Receiver: %s\n", msg.text);

    msgctl(id, IPC_RMID, NULL);

    return 0;
}
