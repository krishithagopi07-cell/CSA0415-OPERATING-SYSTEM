
#include <stdio.h>
int main() {
    int p[20],f[10],n,m,i,j,k,pos,far,next,hit,fault=0;

    printf("Enter number of pages: ");
    scanf("%d",&n);
    printf("Enter pages: ");
    for(i=0;i<n;i++) scanf("%d",&p[i]);
    printf("Enter frames: ");
    scanf("%d",&m);

    for(i=0;i<m;i++) f[i]=-1;

    for(i=0;i<n;i++) {
        hit=0;
        for(j=0;j<m;j++)
            if(f[j]==p[i]) hit=1;

        if(!hit) {
            pos=-1;
            far=-1;

            for(j=0;j<m;j++) {
                if(f[j]==-1) {
                    pos=j;
                    break;
                }

                for(k=i+1;k<n && p[k]!=f[j];k++);
                next=(k==n)?999:k;

                if(next>far) {
                    far=next;
                    pos=j;
                }
            }

            f[pos]=p[i];
            fault++;
        }

        for(j=0;j<m;j++) printf("%d ",f[j]);
        printf("\n");
    }

    printf("Page Faults: %d",fault);
    return 0;
}
