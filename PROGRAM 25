
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd;
    char data[] = "Operating System";
    char buf[50] = {0};
    struct stat st;
    struct dirent *entry;
    DIR *dir;

    fd = open("test.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if (fd < 0) {
        perror("File open");
        return 1;
    }

    write(fd, data, sizeof(data) - 1);

    printf("File Flags: %d\n", fcntl(fd, F_GETFL));

    lseek(fd, 0, SEEK_SET);
    read(fd, buf, sizeof(buf) - 1);
    printf("File Content: %s\n", buf);

    if (stat("test.txt", &st) == 0)
        printf("File Size: %ld bytes\n", (long)st.st_size);

    close(fd);

    dir = opendir(".");
    if (dir != NULL) {
        printf("Directory Files:\n");
        while ((entry = readdir(dir)) != NULL)
            printf("%s\n", entry->d_name);
        closedir(dir);
    }

    return 0;
}
