
#include <stdio.h>
int main() {
    int b[20],n,i;

    printf("Enter number of blocks: ");
    scanf("%d",&n);
    printf("Enter block numbers: ");
    for(i=0;i<n;i++) scanf("%d",&b[i]);

    printf("Linked Allocation:\n");
    for(i=0;i<n;i++) {
        if(i<n-1)
            printf("%d -> %d\n",b[i],b[i+1]);
        else
            printf("%d -> NULL\n",b[i]);
    }

    return 0;
}
